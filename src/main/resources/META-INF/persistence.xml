<?xml version="1.0" encoding="UTF-8" ?>
<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        https://jakarta.ee/xml/ns/persistence
    https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

    <persistence-unit
            name="learningTracker"
            transaction-type="JTA">

        <jta-data-source>
            jdbc/learningTracker
        </jta-data-source>

        <class>
            com.barbarawilliams.persistence.ChallengeEntity
        </class>
        <class>
            com.barbarawilliams.persistence.EvidenceEntity
        </class>

        <properties>
            <property
                    name="jakarta.persistence.schema-generation.database.action"
                    value="none" />

            <property
                    name="eclipselink.target-database"
                    value="org.eclipse.persistence.platform.database.PostgreSQLPlatform" />
        </properties>
    </persistence-unit>
</persistence>